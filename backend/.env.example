APP_NAME=SEDAPAL GIS API
DATABASE_URL=postgresql://usuario:password@127.0.0.1:5432/bd_facturacion_local

# Solo se usa para confirmar la contraseña en /auth/login; la sesión en sí
# (tokens, expiración, verificación) es local y no depende de Supabase.
SUPABASE_URL=https://proyecto.supabase.co
SUPABASE_ANON_KEY=sb_publishable_reemplazar

# Secreto propio para firmar/verificar los JWT de sesión (HS256). Generar con
# algo como: python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_DAYS=30

ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost
