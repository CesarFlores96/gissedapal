  "cards": [
    {
      "dot": "emerald",
      "title": "Aislamiento de Persistencia",
      "items": [
        "El cliente React nunca interactúa directamente con PostgreSQL",
        "Todas las llamadas pasan por el puente IPC de Tauri hacia Rust",
        "Rust actúa como BFF gestionando tokens y peticiones HTTP autenticadas"
      ]
    },
    {
      "dot": "cyan",
      "title": "Gestión de Sesión",
      "items": [
        "El access token permanece exclusivamente en la memoria de Rust",
        "El refresh token se custodia de forma segura en Windows Keyring",
        "Auto-renovación silenciosa sin interrupciones para el operador"
      ]
    },
    {
      "dot": "rose",
      "title": "Optimización Espacial",
      "items": [
        "PostGIS evalúa intersecciones espaciales y proyecta en SRID:4326",
        "FastAPI serializa entidades validadas con modelos Pydantic",
        "Rust cachea respuestas frecuentes por 60s evitando latencia innecesaria"
      ]
    }
  ]
